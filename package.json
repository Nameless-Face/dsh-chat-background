{
  "name": "dsh-plugin-chat-background",
  "version": "1.0.0",
  "description": "Use a local image as the DeepSeek Harness window background: toggle, switch images, tune sidebar and conversation opacity separately, with a text veil, frosted glass and a live usage popover.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "background",
    "wallpaper",
    "theme"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nameless-Face/dsh-chat-background.git"
  },
  "homepage": "https://github.com/Nameless-Face/dsh-chat-background#readme",
  "bugs": {
    "url": "https://github.com/Nameless-Face/dsh-chat-background/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
